<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DetectiveGodot</RootNamespace>
    <!-- 공유 로직은 Unity 6(C# 9) 기준으로 쓰였다. 새 경고로 빌드를 막지 않는다. -->
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!--
    Unity 프로젝트의 순수 C# 로직(§18-1을 지킨 48개 파일, 약 6,000줄)을 여기서 같이 컴파일한다.
    복사가 아니라 원본 파일을 직접 가리킨다 — 두 벌로 갈라지면 "같은 게임"이 아니게 된다.
    목록은 `python tools/sync_godot.py`가 만든다. 손으로 고치지 말 것.
  -->
  <Import Project="SharedLogic.props" />
</Project>
