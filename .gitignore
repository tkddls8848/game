# ---- Unity ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated files
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Test results (batchmode)
TestResults.xml
*.log

# 에셋 원본 압축본 보관소. 받은 팩을 그대로 두는 곳이라 저장소에 넣지 않는다.
# 실제로 쓰는 파일은 Assets/Resources 아래에 풀려 있고, 어느 ZIP의 어느 경로에서
# 왔는지와 SHA-256은 docs/additional-assets.json 에 적혀 있으므로 출처는 추적된다.
/AssetDownloads/

# ── Godot 이식본 ────────────────────────────────────────────
# 규칙: 한 소스만 git에 둔다. Godot 쪽의 생성물은 넣지 않는다.
#
# data/ 와 fonts/ 는 Unity 프로젝트(Assets/Resources)의 사본이다. Godot은 res:// 밖을
# 읽지 못해 어쩔 수 없이 복사하지만, 두 벌을 커밋하면 갈라진다. 원본은 Unity 쪽 하나이고
# `python tools/sync_godot.py`가 언제든 다시 만든다.
# SharedLogic.props 는 빌드 입력이라 **커밋한다** — 없으면 파이썬 없이 빌드할 수 없다.
/DetectiveGodot/data/
/DetectiveGodot/fonts/
/DetectiveGodot/.godot/
/DetectiveGodot/bin/
/DetectiveGodot/obj/
/DetectiveGodot/.mono/

# 엔진 없이 돌리는 테스트 묶음의 빌드 산출물
/SharedLogicTests/bin/
/SharedLogicTests/obj/
/DetectivePrototype/TestBuild/
/DetectivePrototype/Build/

# ── 손으로 쓴 프로젝트 파일은 예외 ─────────────────────────
# 위쪽 `*.csproj`/`*.sln` 규칙은 Unity가 **생성하는** 것을 막으려는 것이다.
# 아래 둘은 생성물이 아니라 우리가 쓴 빌드 정의라서 반드시 커밋해야 한다
# (없으면 새로 클론한 곳에서 Godot 판을 빌드할 수 없다).
!/DetectiveGodot/DetectiveGodot.csproj
!/SharedLogicTests/SharedLogicTests.csproj
