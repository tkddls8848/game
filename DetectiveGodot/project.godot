; Godot 프로젝트 설정. 텍스트 파일이라 손으로도 에이전트로도 안전하게 쓸 수 있다
; — Unity의 ProjectSettings.asset(YAML+GUID)과 다른 점이고, 이 비교의 핵심 중 하나다.

config_version=5

[application]

config/name="블랙우드 저택 (Godot)"
config/description="Unity 판과 같은 순수 C# 로직을 공유하는 Godot 이식본."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="DetectiveGodot"

[rendering]

; 2D 평면도뿐이라 호환 렌더러로 충분하다. 실행 부담이 가장 적다.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.051, 0.051, 0.063, 1)
